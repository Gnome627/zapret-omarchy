#!/bin/bash
# Wrapper around zapret (nfqws): DPI bypass for Discord and YouTube.
# On Omarchy the control window opens with Super+Z (plugin gnome627.zapret);
# everywhere else the same commands are used from a terminal.
# System side: zapret-toggle@<strategy>.service, configs in /etc/zapret-toggle/.

set -u

SELF=$(readlink -f "$0")
STRATEGY_DIR=/etc/zapret-toggle/strategies
STATE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/zapret-toggle
STATE_FILE=$STATE_DIR/strategy
AUTOSTART_FILE=$STATE_DIR/autostart
LOGO_FILE=${XDG_DATA_HOME:-$HOME/.local/share}/zapret-toggle/logo.txt
PLUGIN_ID=gnome627.zapret

HOSTS_FILE=/etc/zapret-toggle/hosts.txt

# Seconds per request. With a working strategy the reply comes in a fraction
# of a second, and a blocked connection just hangs, so waiting longer is pointless.
PROBE_TIMEOUT=3

# Upper limit on how many hosts from the list get probed. A longer list is
# sampled evenly: autopick must not stretch into minutes.
PROBE_MAX_HOSTS=60

# These hosts let the check tell blocking apart from a dead connection.
CONTROL_HOSTS=(github.com www.google.com)

notify() {
  command -v notify-send >/dev/null || return 0
  # Replace the previous notification instead of stacking them.
  local idfile=${XDG_RUNTIME_DIR:-/tmp}/zapret-toggle.notify id=0
  [[ -r $idfile ]] && id=$(<"$idfile")
  notify-send -a Zapret -t 2500 -p -r "${id:-0}" "$1" "${2:-}" >"$idfile" 2>/dev/null
}

strategies() {
  local f
  for f in "$STRATEGY_DIR"/*.args; do
    [[ -e $f ]] && basename "$f" .args
  done
}

# The first line of a strategy file is its English description; an optional
# "# ru: ..." line carries the Russian one for the control window.
describe() {
  sed -n '1s/^# *//p' "$STRATEGY_DIR/$1.args"
}

describe_ru() {
  sed -n 's/^# ru: *//p' "$STRATEGY_DIR/$1.args" | head -n1
}

current_strategy() {
  local s=""
  [[ -r $STATE_FILE ]] && s=$(<"$STATE_FILE")
  [[ -n $s && -r $STRATEGY_DIR/$s.args ]] || s=$(strategies | head -n1)
  echo "$s"
}

save_strategy() {
  mkdir -p "$STATE_DIR"
  echo "$1" >"$STATE_FILE"
}

active_units() {
  systemctl list-units 'zapret-toggle@*.service' --state=active,activating \
    --no-legend --plain 2>/dev/null | awk '{print $1}'
}

active_strategy() {
  active_units | head -n1 | sed -E 's/^zapret-toggle@(.*)\.service$/\1/'
}

# Starting and stopping the service. In a local graphical session the polkit
# rule allows it; where the rule does not apply (SSH, old polkit) fall back to sudo.
service() {
  if ((EUID == 0)); then
    systemctl "$@"
  else
    systemctl --no-ask-password "$@" 2>/dev/null || sudo systemctl "$@"
  fi
}

stop_all() {
  local u
  for u in $(active_units); do
    service stop "$u" || return 1
  done
}

start() {
  stop_all || return 1
  service start "zapret-toggle@$1.service" || return 1
  sleep 0.2
  systemctl is-active --quiet "zapret-toggle@$1.service"
}

# The hostlist is the single source of hosts for both nfqws and the probes.
hosts() {
  grep -vE '^[[:space:]]*([#;/]|$)' "$HOSTS_FILE" 2>/dev/null |
    tr -d ' \t\r' | tr '[:upper:]' '[:lower:]' | awk '!seen[$0]++'
}

# At most PROBE_MAX_HOSTS hosts, spread evenly over the whole list.
sample_hosts() {
  hosts | awk -v max="$PROBE_MAX_HOSTS" '
    { line[NR] = $0 }
    END {
      if (NR <= max) { for (i = 1; i <= NR; i++) print line[i]; exit }
      for (i = 0; i < max; i++) print line[int(i * NR / max) + 1]
    }'
}

# Probes all hosts at once; writes one file per host into directory $1
# holding "<HTTP code> <seconds> <curl exit code>".
probe_all() {
  local dir=$1 i=0 host
  shift
  for host in "$@"; do
    curl -4 -s -o /dev/null -m "$PROBE_TIMEOUT" --connect-timeout 2 \
      -w '%{http_code} %{time_total} %{exitcode}' "https://$host" >"$dir/$i" 2>/dev/null &
    i=$((i + 1))
  done
  wait
}

# Same, but the few hosts that did not answer are probed once more: a domain
# may have one dead address among several, which is not the strategy's fault.
probe_retry() {
  local dir=$1 i code exit again=() index=()
  shift
  probe_all "$dir" "$@"
  for ((i = 0; i < $#; i++)); do
    read -r code _ exit <"$dir/$i"
    if [[ $(verdict "$code" "$exit") == fail ]]; then
      index+=("$i")
      again+=("${@:i+1:1}")
    fi
  done
  ((${#again[@]} > 0 && ${#again[@]} <= 5)) || return 0
  mkdir "$dir/retry"
  probe_all "$dir/retry" "${again[@]}"
  for ((i = 0; i < ${#index[@]}; i++)); do
    mv "$dir/retry/$i" "$dir/${index[i]}"
  done
  rmdir "$dir/retry"
}

# What a probe result means:
#   ok      the server answered, the block is bypassed
#   noaddr  the domain has no address (a suffix like ytimg.com, not a site)
#   cert    the connection went through but the certificate is for another
#           name: either not a site, or DNS is spoofed. Not strategy-related.
#   fail    no answer: blocked
verdict() {
  local code=${1:-000} exit=${2:-28}
  if [[ $code != 000 ]]; then
    echo ok
  elif [[ $exit == 6 ]]; then
    echo noaddr
  elif [[ $exit == 60 || $exit == 51 ]]; then
    echo cert
  else
    echo fail
  fi
}


cmd_on() {
  local s=${1:-}
  [[ -n $s ]] || s=$(current_strategy)
  if start "$s"; then
    notify "Zapret enabled" "Strategy: $s"
    echo "on ($s)"
  else
    notify "Zapret failed to start" "journalctl -u zapret-toggle@$s"
    echo "failed to start zapret-toggle@$s" >&2
    return 1
  fi
}

cmd_off() {
  if stop_all; then
    notify "Zapret disabled"
    echo "off"
  else
    notify "Zapret failed to stop"
    return 1
  fi
}

cmd_status() {
  local a
  a=$(active_strategy)
  if [[ -n $a ]]; then
    echo "on ($a)"
  else
    echo "off (selected strategy: $(current_strategy))"
  fi
}

cmd_list() {
  local s cur
  cur=$(current_strategy)
  for s in $(strategies); do
    printf '%s %-32s %s\n' "$([[ $s == "$cur" ]] && echo '*' || echo ' ')" "$s" "$(describe "$s")"
  done
}

cmd_strategy() {
  local s=${1:-}
  if [[ -z $s ]]; then
    cmd_list
    return
  fi
  if [[ ! -r $STRATEGY_DIR/$s.args ]]; then
    # The number alone is enough: "zapret-toggle strategy 8"
    s=$(strategies | grep -m1 -E "^0*$1-" || true)
    [[ -n $s ]] || { echo "no such strategy: $1" >&2; return 1; }
  fi
  save_strategy "$s"
  [[ -n $(active_strategy) ]] && { cmd_on "$s"; return; }
  echo "selected strategy: $s"
}

# Autostart is a flag file: on login the session runs
# "zapret-toggle autostart run", which enables zapret if the flag is set.
cmd_autostart() {
  case ${1:-status} in
    status) [[ -e $AUTOSTART_FILE ]] ;;
    on)
      mkdir -p "$STATE_DIR" && touch "$AUTOSTART_FILE"
      notify "Zapret autostart enabled"
      ;;
    off)
      rm -f "$AUTOSTART_FILE"
      notify "Zapret autostart disabled"
      ;;
    toggle) if [[ -e $AUTOSTART_FILE ]]; then cmd_autostart off; else cmd_autostart on; fi ;;
    run) [[ -e $AUTOSTART_FILE ]] && start "$(current_strategy)" ;;
    *) echo "autostart [status|on|off|toggle|run]" >&2; return 2 ;;
  esac
}

# Edit the hostlist (needs the sudo password) and restart zapret if it is on.
cmd_hosts() {
  sudoedit "$HOSTS_FILE" || return 1
  local a
  a=$(active_strategy)
  [[ -z $a ]] || cmd_on "$a"
}

# Tries the strategies and keeps the first one that opens every host in the
# list. Hosts without an address or with a foreign certificate do not count:
# no strategy affects them. With --all the whole strategy list is tried.
cmd_test() {
  local all=0 s i ok fail best="" best_ok=-1 best_fail=0 best_failed="" failed tmp code exit list total
  [[ ${1:-} == --all ]] && all=1
  mapfile -t list < <(sample_hosts)
  total=${#list[@]}
  ((total > 0)) || { echo "The hostlist is empty: $HOSTS_FILE" >&2; return 1; }
  tmp=$(mktemp -d)

  # If the run is interrupted (terminal closed, Ctrl+C) restore what was
  # there before instead of leaving the strategy being tried switched on.
  local was_on
  was_on=$(active_strategy)
  trap 'rm -rf "$tmp"; if [[ -n $was_on ]]; then start "$was_on"; else stop_all; fi; exit 130' INT TERM HUP

  printf 'Trying %d strategies on %d hosts from the list (up to %d s per strategy)\n' \
    "$(strategies | wc -l)" "$total" "$PROBE_TIMEOUT"
  (($(hosts | wc -l) > total)) && printf 'The hostlist is longer; a sample of %d is used.\n' "$total"
  echo

  for s in $(strategies); do
    printf '  %-30s ' "$s"
    if ! start "$s"; then
      echo "failed to start"
      continue
    fi
    probe_retry "$tmp" "${list[@]}"
    ok=0
    fail=0
    failed=""
    for ((i = 0; i < total; i++)); do
      read -r code _ exit <"$tmp/$i"
      case $(verdict "$code" "$exit") in
        ok)
          ok=$((ok + 1))
          printf '\033[32m●\033[0m'
          ;;
        fail)
          fail=$((fail + 1))
          failed+=" ${list[i]}"
          printf '\033[31m○\033[0m'
          ;;
        *) printf '\033[2m·\033[0m' ;;
      esac
    done
    echo " $ok/$((ok + fail))"
    if ((ok > best_ok)); then
      best=$s
      best_ok=$ok
      best_fail=$fail
      best_failed=$failed
    fi
    ((ok > 0 && fail == 0 && !all)) && break
  done
  rm -rf "$tmp"
  trap - INT TERM HUP
  echo

  if ((best_ok <= 0)); then
    if [[ -n $was_on ]]; then start "$was_on"; else stop_all; fi
    echo "No strategy worked."
    notify "Zapret: no strategy worked"
    return 1
  fi
  save_strategy "$best"
  cmd_on "$best" >/dev/null
  echo "Selected: $best ($best_ok/$((best_ok + best_fail)))"
  ((best_fail == 0)) || echo "Still unreachable:$best_failed"
}

# The host answers with a foreign certificate. If it opens fine at the
# address a public DNS returns, the system DNS is handing out a spoofed one.
dns_spoofed() {
  local real
  real=$(curl -s -m 5 -H 'accept: application/dns-json' \
    "https://1.1.1.1/dns-query?name=$1&type=A" 2>/dev/null |
    jq -r '[.Answer[]? | select(.type == 1)][0].data // empty' 2>/dev/null)
  [[ -n $real ]] && ! getent ahostsv4 "$1" | grep -qF "$real " &&
    [[ $(curl -4 -s -o /dev/null -m "$PROBE_TIMEOUT" --resolve "$1:443:$real" \
      -w '%{http_code}' "https://$1" 2>/dev/null) != 000 ]]
}

# Goes through every host in the list and shows which ones open right now.
cmd_check() {
  local tmp i f code secs exit host mark note ok=0 fail=0 skip=0 spoof=0 net="down" list cells=() half
  mapfile -t list < <(hosts)
  tmp=$(mktemp -d)
  mkdir "$tmp/control" "$tmp/hosts"

  probe_all "$tmp/control" "${CONTROL_HOSTS[@]}" &
  # In batches, so a long list does not fire hundreds of requests at once.
  for ((i = 0; i < ${#list[@]}; i += PROBE_MAX_HOSTS)); do
    mkdir "$tmp/batch"
    probe_retry "$tmp/batch" "${list[@]:i:PROBE_MAX_HOSTS}"
    for f in "$tmp/batch"/*; do mv "$f" "$tmp/hosts/$((i + ${f##*/}))"; done
    rmdir "$tmp/batch"
  done
  wait

  for ((i = 0; i < ${#CONTROL_HOSTS[@]}; i++)); do
    read -r code _ <"$tmp/control/$i"
    [[ ${code:-000} == 000 ]] || net="up"
  done
  printf 'Zapret: %s · internet: %s\n\n' "$(cmd_status)" "$net"

  for ((i = 0; i < ${#list[@]}; i++)); do
    host=${list[i]}
    read -r code secs exit <"$tmp/hosts/$i"
    case $(verdict "$code" "$exit") in
      ok)
        ok=$((ok + 1))
        mark='\033[32m●\033[0m'
        note=$(awk -v s="$secs" 'BEGIN { printf "%d ms", s * 1000 }')
        ;;
      fail | cert)
        # Either way the address may be a spoofed one; a strategy cannot fix that.
        if dns_spoofed "$host"; then
          spoof=$((spoof + 1))
          mark='\033[33m◍\033[0m'
          note="DNS spoofed"
        elif [[ $(verdict "$code" "$exit") == fail ]]; then
          fail=$((fail + 1))
          mark='\033[31m○\033[0m'
          note="no reply"
        else
          skip=$((skip + 1))
          mark='\033[2m·\033[0m'
          note="not a site"
        fi
        ;;
      noaddr)
        skip=$((skip + 1))
        mark='\033[2m·\033[0m'
        note="no address"
        ;;
    esac
    ((${#host} <= 30)) || host=${host:0:29}…
    # Pad by hand: printf counts width in bytes, and the ellipsis is multibyte.
    cells+=("$(printf '%b %s%*s %s%*s' "$mark" "$host" $((30 - ${#host})) '' "$note" $((12 - ${#note})) '')")
  done
  rm -rf "$tmp"

  # Two columns, so the list fits in the terminal window.
  half=$(((${#cells[@]} + 1) / 2))
  for ((i = 0; i < half; i++)); do
    printf '  %s  %s\n' "${cells[i]}" "${cells[i + half]:-}"
  done

  printf '\nReachable: %d of %d.' "$ok" "$((ok + fail + spoof))"
  ((spoof == 0)) || printf ' DNS spoofed: %d (zapret cannot fix that, switch to another DNS).' "$spoof"
  ((skip == 0)) || printf ' Not checked: %d.' "$skip"
  echo
  ((fail == 0 && spoof == 0))
}


# State for the control window, as one JSON object.
cmd_state() {
  local s cur active list
  cur=$(current_strategy)
  active=$(active_strategy)
  list=$(for s in $(strategies); do printf '%s\t%s\t%s\n' "$s" "$(describe "$s")" "$(describe_ru "$s")"; done |
    jq -Rn '[inputs | split("\t") | {name: .[0], description: .[1], description_ru: .[2]}]')
  jq -n --arg active "$active" --arg strategy "$cur" --rawfile logo "$LOGO_FILE" \
    --argjson autostart "$([[ -e $AUTOSTART_FILE ]] && echo true || echo false)" \
    --argjson strategies "$list" \
    '{on: ($active != ""), strategy: (if $active != "" then $active else $strategy end),
      autostart: $autostart, strategies: $strategies, logo: $logo}'
}

# Opens the control window. It exists only on Omarchy; elsewhere print the
# status and the command list.
cmd_menu() {
  if command -v omarchy-shell >/dev/null; then
    exec omarchy-shell shell toggle "$PLUGIN_ID" '{}'
  fi
  cmd_status
  echo
  "$SELF" help
}

# Runs a subcommand in an Omarchy floating terminal under the zapret logo.
# Without Omarchy it runs right here.
cmd_term() {
  command -v omarchy-shell >/dev/null || exec "$SELF" present "$@"
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Zapret \
    -e "$SELF" present "$@"
}

cmd_present() {
  clear
  printf '\033[32m'
  sed 's/^/  /' "$LOGO_FILE"
  printf '\033[0m\n'
  "$SELF" "$@"
  local rc=$?
  ((rc == 130)) || ! command -v omarchy-show-done >/dev/null || omarchy-show-done
  return "$rc"
}

case ${1:-menu} in
  menu) cmd_menu ;;
  toggle) if [[ -n $(active_strategy) ]]; then cmd_off; else cmd_on; fi ;;
  on) cmd_on "${2:-}" ;;
  off) cmd_off ;;
  status) cmd_status ;;
  is-on) [[ -n $(active_strategy) ]] ;;
  current) current_strategy ;;
  list) cmd_list ;;
  strategy) cmd_strategy "${2:-}" ;;
  test) cmd_test "${2:-}" ;;
  check) cmd_check ;;
  autostart) cmd_autostart "${2:-}" ;;
  hosts) cmd_hosts ;;
  state) cmd_state ;;
  term) cmd_term "${@:2}" ;;
  present) cmd_present "${@:2}" ;;
  *)
    cat <<USAGE
Usage: zapret-toggle [command]
  menu             open/close the control window (default; Super+Z on Omarchy)
  toggle           turn the bypass on or off
  on | off         turn it on / off
  status           current state
  check            go through the hostlist and show what is reachable
  list             list strategies
  strategy <name>  select a strategy (the number alone is enough)
  test [--all]     try strategies on the hostlist and keep a working one
  autostart <on|off|toggle|status>   start on login
  hosts            edit the hostlist
  term <command>   run a command in a floating terminal
USAGE
    ;;
esac
