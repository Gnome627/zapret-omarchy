#!/bin/bash
# Обёртка над zapret (nfqws): обход DPI для Discord и YouTube.
# Окошко управления открывается по Super+Z (плагин gnome627.zapret).
# Системная часть: zapret-toggle@<стратегия>.service, конфиги в /etc/zapret-toggle/.

set -u

SELF=$(readlink -f "$0")
STRATEGY_DIR=/etc/zapret-toggle/strategies
STATE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/zapret-toggle
STATE_FILE=$STATE_DIR/strategy
AUTOSTART_FILE=$STATE_DIR/autostart
LOGO_FILE=${XDG_DATA_HOME:-$HOME/.local/share}/zapret-toggle/logo.txt
PLUGIN_ID=gnome627.zapret

HOSTS_FILE=/etc/zapret-toggle/hosts.txt

# Секунд на один запрос. С рабочей стратегией ответ приходит за доли секунды,
# а заблокированное соединение просто висит, так что ждать дольше нет смысла.
PROBE_TIMEOUT=3

# Сколько адресов из списка опрашивать самое большее. Если в списке больше,
# берётся равномерная выборка: автоподбор не должен растягиваться на минуты.
PROBE_MAX_HOSTS=60

# По этим адресам проверка отличает блокировку от пропавшего интернета.
CONTROL_HOSTS=(github.com www.google.com)

notify() {
  command -v notify-send >/dev/null || return 0
  # Заменяем предыдущее уведомление, а не копим стопку.
  local idfile=${XDG_RUNTIME_DIR:-/tmp}/zapret-toggle.notify id=0
  [[ -r $idfile ]] && id=$(<"$idfile")
  notify-send -a Zapret -t 2500 -p -r "${id:-0}" "$1" "${2:-}" >"$idfile" 2>/dev/null
}

strategies() {
  local f
  for f in "$STRATEGY_DIR"/*.args; do
    [[ -e $f ]] && basename "$f" .args
  done
}

describe() {
  sed -n '1s/^# *//p' "$STRATEGY_DIR/$1.args"
}

current_strategy() {
  local s=""
  [[ -r $STATE_FILE ]] && s=$(<"$STATE_FILE")
  [[ -n $s && -r $STRATEGY_DIR/$s.args ]] || s=$(strategies | head -n1)
  echo "$s"
}

save_strategy() {
  mkdir -p "$STATE_DIR"
  echo "$1" >"$STATE_FILE"
}

active_units() {
  systemctl list-units 'zapret-toggle@*.service' --state=active,activating \
    --no-legend --plain 2>/dev/null | awk '{print $1}'
}

active_strategy() {
  active_units | head -n1 | sed -E 's/^zapret-toggle@(.*)\.service$/\1/'
}

stop_all() {
  local u
  for u in $(active_units); do
    systemctl stop "$u" || return 1
  done
}

start() {
  stop_all || return 1
  systemctl start "zapret-toggle@$1.service" || return 1
  sleep 0.2
  systemctl is-active --quiet "zapret-toggle@$1.service"
}

# Домены из списка — единственный источник адресов и для nfqws, и для проверок.
hosts() {
  grep -vE '^[[:space:]]*([#;/]|$)' "$HOSTS_FILE" 2>/dev/null |
    tr -d ' \t\r' | tr '[:upper:]' '[:lower:]' | awk '!seen[$0]++'
}

# Не больше PROBE_MAX_HOSTS адресов, равномерно по всему списку.
sample_hosts() {
  hosts | awk -v max="$PROBE_MAX_HOSTS" '
    { line[NR] = $0 }
    END {
      if (NR <= max) { for (i = 1; i <= NR; i++) print line[i]; exit }
      for (i = 0; i < max; i++) print line[int(i * NR / max) + 1]
    }'
}

# Опрашивает все адреса одновременно; в каталог $1 кладёт по файлу на адрес
# с "<код HTTP> <секунды> <код выхода curl>".
probe_all() {
  local dir=$1 i=0 host
  shift
  for host in "$@"; do
    curl -4 -s -o /dev/null -m "$PROBE_TIMEOUT" --connect-timeout 2 \
      -w '%{http_code} %{time_total} %{exitcode}' "https://$host" >"$dir/$i" 2>/dev/null &
    i=$((i + 1))
  done
  wait
}

# То же, но немногие неответившие адреса опрашивает ещё раз: у домена
# бывает один нерабочий адрес из нескольких, и это не вина стратегии.
probe_retry() {
  local dir=$1 i code exit again=() index=()
  shift
  probe_all "$dir" "$@"
  for ((i = 0; i < $#; i++)); do
    read -r code _ exit <"$dir/$i"
    if [[ $(verdict "$code" "$exit") == fail ]]; then
      index+=("$i")
      again+=("${@:i+1:1}")
    fi
  done
  ((${#again[@]} > 0 && ${#again[@]} <= 5)) || return 0
  mkdir "$dir/retry"
  probe_all "$dir/retry" "${again[@]}"
  for ((i = 0; i < ${#index[@]}; i++)); do
    mv "$dir/retry/$i" "$dir/${index[i]}"
  done
  rmdir "$dir/retry"
}

# Что значит ответ на запрос:
#   ok      сервер ответил, блокировка обойдена
#   noaddr  у домена нет адреса (это суффикс вроде ytimg.com, а не сайт)
#   cert    соединение прошло, но сертификат чужой: это либо не сайт,
#           либо DNS подменяет адрес. От стратегии не зависит.
#   fail    ответа нет: заблокировано
verdict() {
  local code=${1:-000} exit=${2:-28}
  if [[ $code != 000 ]]; then
    echo ok
  elif [[ $exit == 6 ]]; then
    echo noaddr
  elif [[ $exit == 60 || $exit == 51 ]]; then
    echo cert
  else
    echo fail
  fi
}


cmd_on() {
  local s=${1:-}
  [[ -n $s ]] || s=$(current_strategy)
  if start "$s"; then
    notify "Zapret включён" "Стратегия: $s"
    echo "on ($s)"
  else
    notify "Zapret: ошибка запуска" "journalctl -u zapret-toggle@$s"
    echo "failed to start zapret-toggle@$s" >&2
    return 1
  fi
}

cmd_off() {
  if stop_all; then
    notify "Zapret выключен"
    echo "off"
  else
    notify "Zapret: не удалось остановить"
    return 1
  fi
}

cmd_status() {
  local a
  a=$(active_strategy)
  if [[ -n $a ]]; then
    echo "on ($a)"
  else
    echo "off (выбрана стратегия: $(current_strategy))"
  fi
}

cmd_list() {
  local s cur
  cur=$(current_strategy)
  for s in $(strategies); do
    printf '%s %-32s %s\n' "$([[ $s == "$cur" ]] && echo '*' || echo ' ')" "$s" "$(describe "$s")"
  done
}

cmd_strategy() {
  local s=${1:-}
  if [[ -z $s ]]; then
    cmd_list
    return
  fi
  if [[ ! -r $STRATEGY_DIR/$s.args ]]; then
    # Разрешаем указывать только номер: "zapret-toggle strategy 8"
    s=$(strategies | grep -m1 -E "^0*$1-" || true)
    [[ -n $s ]] || { echo "нет такой стратегии: $1" >&2; return 1; }
  fi
  save_strategy "$s"
  [[ -n $(active_strategy) ]] && { cmd_on "$s"; return; }
  echo "выбрана стратегия: $s"
}

# Автозапуск — это флаг-файл: при входе в сессию Hyprland вызывает
# "zapret-toggle autostart run", и zapret включается, если флаг стоит.
cmd_autostart() {
  case ${1:-status} in
    status) [[ -e $AUTOSTART_FILE ]] ;;
    on)
      mkdir -p "$STATE_DIR" && touch "$AUTOSTART_FILE"
      notify "Zapret: автозапуск включён"
      ;;
    off)
      rm -f "$AUTOSTART_FILE"
      notify "Zapret: автозапуск выключен"
      ;;
    toggle) if [[ -e $AUTOSTART_FILE ]]; then cmd_autostart off; else cmd_autostart on; fi ;;
    run) [[ -e $AUTOSTART_FILE ]] && start "$(current_strategy)" ;;
    *) echo "autostart [status|on|off|toggle|run]" >&2; return 2 ;;
  esac
}

# Правка списка доменов (нужен пароль sudo) с перезапуском, если zapret включён.
cmd_hosts() {
  sudoedit "$HOSTS_FILE" || return 1
  local a
  a=$(active_strategy)
  [[ -z $a ]] || cmd_on "$a"
}

# Перебирает стратегии и оставляет включённой первую, с которой открываются
# все домены из списка. Домены без адреса и с чужим сертификатом не учитываются:
# на них стратегия не влияет. С --all проходит весь список стратегий.
cmd_test() {
  local all=0 s i ok fail best="" best_ok=-1 best_fail=0 best_failed="" failed tmp code exit list total
  [[ ${1:-} == --all ]] && all=1
  mapfile -t list < <(sample_hosts)
  total=${#list[@]}
  ((total > 0)) || { echo "Список доменов пуст: $HOSTS_FILE" >&2; return 1; }
  tmp=$(mktemp -d)

  # Если перебор прервали (закрыли терминал, Ctrl+C), возвращаем то, что было,
  # а не оставляем включённой стратегию, на которой остановились.
  local was_on
  was_on=$(active_strategy)
  trap 'rm -rf "$tmp"; if [[ -n $was_on ]]; then start "$was_on"; else stop_all; fi; exit 130' INT TERM HUP

  printf 'Проверяю %d стратегий на %d доменах из списка (до %d с на стратегию)\n' \
    "$(strategies | wc -l)" "$total" "$PROBE_TIMEOUT"
  (($(hosts | wc -l) > total)) && printf 'В списке доменов больше, взята выборка из %d.\n' "$total"
  echo

  for s in $(strategies); do
    printf '  %-30s ' "$s"
    if ! start "$s"; then
      echo "не запустилась"
      continue
    fi
    probe_retry "$tmp" "${list[@]}"
    ok=0
    fail=0
    failed=""
    for ((i = 0; i < total; i++)); do
      read -r code _ exit <"$tmp/$i"
      case $(verdict "$code" "$exit") in
        ok)
          ok=$((ok + 1))
          printf '\033[32m●\033[0m'
          ;;
        fail)
          fail=$((fail + 1))
          failed+=" ${list[i]}"
          printf '\033[31m○\033[0m'
          ;;
        *) printf '\033[2m·\033[0m' ;;
      esac
    done
    echo " $ok/$((ok + fail))"
    if ((ok > best_ok)); then
      best=$s
      best_ok=$ok
      best_fail=$fail
      best_failed=$failed
    fi
    ((ok > 0 && fail == 0 && !all)) && break
  done
  rm -rf "$tmp"
  trap - INT TERM HUP
  echo

  if ((best_ok <= 0)); then
    if [[ -n $was_on ]]; then start "$was_on"; else stop_all; fi
    echo "Ни одна стратегия не сработала."
    notify "Zapret: ни одна стратегия не сработала"
    return 1
  fi
  save_strategy "$best"
  cmd_on "$best" >/dev/null
  echo "Выбрана: $best ($best_ok/$((best_ok + best_fail)))"
  ((best_fail == 0)) || echo "Не открылись:$best_failed"
}

# Домен отвечает чужим сертификатом. Если по адресу от публичного DNS он
# открывается нормально, значит системный DNS отдаёт подменённый адрес.
dns_spoofed() {
  local real
  real=$(curl -s -m 5 -H 'accept: application/dns-json' \
    "https://1.1.1.1/dns-query?name=$1&type=A" 2>/dev/null |
    jq -r '[.Answer[]? | select(.type == 1)][0].data // empty' 2>/dev/null)
  [[ -n $real ]] && ! getent ahostsv4 "$1" | grep -qF "$real " &&
    [[ $(curl -4 -s -o /dev/null -m "$PROBE_TIMEOUT" --resolve "$1:443:$real" \
      -w '%{http_code}' "https://$1" 2>/dev/null) != 000 ]]
}

# Проходит по всем доменам из списка и показывает, какие сейчас открываются.
cmd_check() {
  local tmp i f code secs exit host mark note ok=0 fail=0 skip=0 spoof=0 net="нет" list cells=() half
  mapfile -t list < <(hosts)
  tmp=$(mktemp -d)
  mkdir "$tmp/control" "$tmp/hosts"

  probe_all "$tmp/control" "${CONTROL_HOSTS[@]}" &
  # Пачками, чтобы длинный список не запускал сотни запросов разом.
  for ((i = 0; i < ${#list[@]}; i += PROBE_MAX_HOSTS)); do
    mkdir "$tmp/batch"
    probe_retry "$tmp/batch" "${list[@]:i:PROBE_MAX_HOSTS}"
    for f in "$tmp/batch"/*; do mv "$f" "$tmp/hosts/$((i + ${f##*/}))"; done
    rmdir "$tmp/batch"
  done
  wait

  for ((i = 0; i < ${#CONTROL_HOSTS[@]}; i++)); do
    read -r code _ <"$tmp/control/$i"
    [[ ${code:-000} == 000 ]] || net="есть"
  done
  printf 'Zapret: %s · интернет: %s\n\n' "$(cmd_status)" "$net"

  for ((i = 0; i < ${#list[@]}; i++)); do
    host=${list[i]}
    read -r code secs exit <"$tmp/hosts/$i"
    case $(verdict "$code" "$exit") in
      ok)
        ok=$((ok + 1))
        mark='\033[32m●\033[0m'
        note=$(awk -v s="$secs" 'BEGIN { printf "%d мс", s * 1000 }')
        ;;
      fail)
        fail=$((fail + 1))
        mark='\033[31m○\033[0m'
        note="нет ответа"
        ;;
      noaddr)
        skip=$((skip + 1))
        mark='\033[2m·\033[0m'
        note="нет адреса"
        ;;
      cert)
        if dns_spoofed "$host"; then
          spoof=$((spoof + 1))
          mark='\033[33m◍\033[0m'
          note="подмена DNS"
        else
          skip=$((skip + 1))
          mark='\033[2m·\033[0m'
          note="не сайт"
        fi
        ;;
    esac
    ((${#host} <= 30)) || host=${host:0:29}…
    # Ширину добиваем пробелами вручную: printf считает её в байтах.
    cells+=("$(printf '%b %s%*s %s%*s' "$mark" "$host" $((30 - ${#host})) '' "$note" $((12 - ${#note})) '')")
  done
  rm -rf "$tmp"

  # Две колонки, чтобы список помещался в окно терминала.
  half=$(((${#cells[@]} + 1) / 2))
  for ((i = 0; i < half; i++)); do
    printf '  %s  %s\n' "${cells[i]}" "${cells[i + half]:-}"
  done

  printf '\nОткрывается %d из %d.' "$ok" "$((ok + fail + spoof))"
  ((spoof == 0)) || printf ' Подмена DNS: %d — zapret тут не поможет, нужен другой DNS.' "$spoof"
  ((skip == 0)) || printf ' Не проверяется: %d.' "$skip"
  echo
  ((fail == 0 && spoof == 0))
}


# Состояние для окошка, одним JSON.
cmd_state() {
  local s cur active list
  cur=$(current_strategy)
  active=$(active_strategy)
  list=$(for s in $(strategies); do printf '%s\t%s\n' "$s" "$(describe "$s")"; done |
    jq -Rn '[inputs | split("\t") | {name: .[0], description: .[1]}]')
  jq -n --arg active "$active" --arg strategy "$cur" --rawfile logo "$LOGO_FILE" \
    --argjson autostart "$([[ -e $AUTOSTART_FILE ]] && echo true || echo false)" \
    --argjson strategies "$list" \
    '{on: ($active != ""), strategy: (if $active != "" then $active else $strategy end),
      autostart: $autostart, strategies: $strategies, logo: $logo}'
}

# Запускает подкоманду в плавающем терминале Omarchy с логотипом zapret.
cmd_term() {
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Zapret \
    -e "$SELF" present "$@"
}

cmd_present() {
  clear
  printf '\033[32m'
  sed 's/^/  /' "$LOGO_FILE"
  printf '\033[0m\n'
  "$SELF" "$@"
  (($? == 130)) || omarchy-show-done
}

case ${1:-menu} in
  menu) exec omarchy-shell shell toggle "$PLUGIN_ID" '{}' ;;
  toggle) if [[ -n $(active_strategy) ]]; then cmd_off; else cmd_on; fi ;;
  on) cmd_on "${2:-}" ;;
  off) cmd_off ;;
  status) cmd_status ;;
  is-on) [[ -n $(active_strategy) ]] ;;
  current) current_strategy ;;
  list) cmd_list ;;
  strategy) cmd_strategy "${2:-}" ;;
  test) cmd_test "${2:-}" ;;
  check) cmd_check ;;
  autostart) cmd_autostart "${2:-}" ;;
  hosts) cmd_hosts ;;
  state) cmd_state ;;
  term) cmd_term "${@:2}" ;;
  present) cmd_present "${@:2}" ;;
  *)
    cat <<USAGE
Использование: zapret-toggle [команда]
  menu             открыть/закрыть окошко (по умолчанию, Super+Z)
  toggle           включить/выключить
  on | off         включить / выключить
  status           текущее состояние
  check            пройтись по списку доменов и показать, что открывается
  list             список стратегий
  strategy <имя>   выбрать стратегию (можно только номер)
  test [--all]     перебрать стратегии на доменах из списка и выбрать рабочую
  autostart <on|off|toggle|status>   автозапуск при входе в систему
  hosts            править список доменов
  term <команда>   выполнить команду в плавающем терминале
USAGE
    ;;
esac
