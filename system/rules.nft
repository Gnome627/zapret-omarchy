# zapret-toggle: sends the first packets of connections to 80/443 and Discord
# voice UDP to NFQUEUE 200, where nfqws handles them. "bypass" means packets
# pass through untouched when nfqws is not running.
table inet zapret_toggle {}
delete table inet zapret_toggle

table inet zapret_toggle {
	chain postnat {
		type filter hook postrouting priority 101;
		meta mark & 0x40000000 != 0 return
		oifname "lo" return
		tcp dport { 80, 443 } ct original packets 1-12 meta mark set meta mark | 0x20000000 queue num 200 bypass
		udp dport { 443, 19294-19344, 50000-50100 } ct original packets 1-12 meta mark set meta mark | 0x20000000 queue num 200 bypass
	}

	chain prenat {
		type filter hook prerouting priority -101;
		iifname != "lo" tcp sport { 80, 443 } ct reply packets 1-3 queue num 200 bypass
	}

	# Packets generated by nfqws itself: keep them out of conntrack,
	# otherwise the fakes get dropped as INVALID.
	chain predefrag {
		type filter hook output priority -401;
		meta mark & 0x40000000 == 0 return
		meta mark & 0x20000000 != 0 notrack
	}
}
