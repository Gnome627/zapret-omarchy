// Lets user @USER@ start and stop zapret-toggle@*.service without a password
// (needed for switching from the Super+Z window).
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units") return;
    if (subject.user != "@USER@" || !subject.local || !subject.active) return;
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (/^zapret-toggle@[a-z0-9_-]+\.service$/.test(unit) &&
        (verb == "start" || verb == "stop" || verb == "restart")) {
        return polkit.Result.YES;
    }
});
